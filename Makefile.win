# Windows Makefile for Hebnix
# Usage: nmake /F Makefile.win [target]
# Targets: all, build, package, clean

HEBNIX_RS_DIR=hebnix_rs
DIST_DIR=$(HEBNIX_RS_DIR)\dist

.PHONY: all build clean package check-rust help

all: build

help:
	@echo Windows build targets for Hebnix:
	@echo   all           - Build Rust components (default)
	@echo   build         - Build Rust components
	@echo   package       - Build release and create distribution package
	@echo   clean         - Remove build artifacts
	@echo   check-rust    - Verify Rust toolchain is installed

check-rust:
	@where cargo >nul 2>&1 || (echo ERROR: Rust not found. Install from https://rustup.rs && exit 1)

build: check-rust
	@cd $(HEBNIX_RS_DIR) && cargo build --release --bin hebnix
	@cd $(HEBNIX_RS_DIR) && cargo build --release --bin hebnix-lite --features lite

package: check-rust
	@cd $(HEBNIX_RS_DIR) && powershell -NoProfile -ExecutionPolicy Bypass -File package.ps1

clean:
	@build.bat clean
