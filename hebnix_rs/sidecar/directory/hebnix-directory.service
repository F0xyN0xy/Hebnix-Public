[Unit]
Description=Hebnix Workshop multiplayer directory
After=network.target

[Service]
DynamicUser=yes
EnvironmentFile=/etc/hebnix-directory.env
ExecStart=/usr/bin/python3 /usr/local/lib/hebnix-directory/directory.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
